# Aplicación Laravel
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/vendor
/template
template/

# Variables de entorno (NUNCA commitear el .env real)
.env
.env.backup
.env.production
.env.staging
!.env.example
!.env.example.production

# Logs
/storage/logs/*.log
storage/logs/*.log

# Caché
bootstrap/cache/*.php
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/

# Assets compilados (se regeneran con npm run build)
public/build
mix-manifest.json
public/mix-manifest.json

# IDEs y editores
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php

