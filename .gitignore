npm-debug.log
yarn-error.log
.npm
.yarn
pnpm-store/
.pnpm-store/

# PHP
*.phpunit.result.cache
coverage/
.phpunit.cache/

# Docker volumes (no commitear datos de volúmenes locales)
.docker/
docker-compose.override.yml

# Sitemap generado (se regenera con sitemap:generate)
/public/sitemap.xml

# Documentación API generada (se regenera con scribe:generate)
