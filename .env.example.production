# Archivo de ejemplo de variables de entorno para PRODUCCIÓN
# Copia este archivo como .env y ajusta los valores para producción

APP_NAME="Mi Proyecto Laravel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.com
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Base de datos PostgreSQL (obligatoria para producción)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nombre_base_datos
DB_USERNAME=usuario_bd
DB_PASSWORD=

# Caché — Redis recomendado para producción
CACHE_STORE=redis
CACHE_PREFIX=skeleton_

# Colas — Database o Redis para producción
QUEUE_CONNECTION=database

# Sesiones — Redis recomendado para producción
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Email — Configuración SMTP para producción
MAIL_MAILER=smtp
MAIL_HOST=smtp.tuservicio.com
MAIL_PORT=587
MAIL_USERNAME=tu_email@tudominio.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="${APP_NAME}"

# Redis — Para caché y colas
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Storage — Filesystem local o S3 para producción
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_BUCKET=nombre-bucket

# Sanctum — Dominio del frontend si es SPA separada
SANCTUM_STATEFUL_DOMAINS=tudominio.com,www.tudominio.com

# Google reCAPTCHA v3 (claves proporcionadas por Google Cloud Console)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Logs
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Broadcasting (desactivado por defecto)
BROADCAST_CONNECTION=null
